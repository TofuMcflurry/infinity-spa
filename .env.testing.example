# Template for the gitignored .env.testing file used by `php artisan test`.
# Copy this to .env.testing and fill in the placeholders — never commit the
# real file. See docs/TESTING.md for full setup instructions.

APP_ENV=testing

# Generate a key dedicated to testing — do NOT reuse the development
# APP_KEY from .env. Easiest way: run `php artisan key:generate --show`
# once (outside this file) and paste the base64:... value below.
APP_KEY=base64:REPLACE_WITH_A_NEW_TESTING_ONLY_KEY

# PostgreSQL — points at an isolated test database, never the dev database.
# DB_DATABASE must be a dedicated database (e.g. infinity_spa_test), and
# DB_USERNAME must be a restricted, non-superuser role that can connect to
# that database only — see docs/TESTING.md for why and how to provision it.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infinity_spa_test
DB_USERNAME=REPLACE_WITH_YOUR_RESTRICTED_TEST_ROLE
DB_PASSWORD=REPLACE_WITH_THAT_ROLES_PASSWORD

# Redis — predis client (matches the app's real driver; the native phpredis
# extension is not required), pointed at a dedicated logical database index
# so test runs never share keyspace with local development Redis (db 0).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=15

# Safe, side-effect-free defaults for everything else — these keep tests
# from sending real mail, using a real queue worker, or opening a real
# broadcast/websocket connection. phpunit.xml already sets most of these;
# they're repeated here for a self-contained reference file.
MAIL_MAILER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
CACHE_STORE=array
SESSION_DRIVER=array

# Stripe — use TEST-mode keys only (sk_test_.../pk_test_...), never live
# keys. No test in this suite calls the real outbound checkout-session
# endpoint, but this still must never be a production/live credential.
STRIPE_KEY=pk_test_REPLACE_WITH_A_TEST_MODE_KEY
STRIPE_SECRET=sk_test_REPLACE_WITH_A_TEST_MODE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_A_TEST_MODE_SECRET
